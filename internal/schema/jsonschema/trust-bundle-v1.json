{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polypkg.dev/schemas/trust-bundle-v1.json",
  "type": "object",
  "required": ["schema", "source", "serial", "expires"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "polypkg.trust-bundle/v1" },
    "source": { "type": "string", "minLength": 1 },
    "serial": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires": { "type": "string", "format": "date-time" },
    "builder_keys": { "type": "array", "items": { "$ref": "#/$defs/builderKey" } },
    "sigstore_roots": { "type": "array", "items": { "$ref": "#/$defs/sigstoreRoot" } }
  },
  "$defs": {
    "builderKey": {
      "type": "object",
      "required": ["key_id", "public_key", "algo", "valid_from"],
      "additionalProperties": false,
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "public_key": { "type": "string", "minLength": 1 },
        "algo": { "type": "string", "enum": ["ed25519"] },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "superseded_by": { "type": "string", "minLength": 1 }
      }
    },
    "sigstoreRoot": {
      "type": "object",
      "required": ["valid_from", "fulcio_ca", "rekor_keys"],
      "additionalProperties": false,
      "properties": {
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "fulcio_ca": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rekor_keys": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "ctlog_keys": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
