{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polypkg.dev/schemas/status-v1.json",
  "type": "object",
  "required": ["schema", "retained"],
  "additionalProperties": false,
  "properties": {
    "schema":  { "type": "string", "const": "polypkg.status/v1" },
    "current": {
      "type": "object",
      "required": ["generation"],
      "additionalProperties": false,
      "properties": {
        "generation":  { "type": "integer", "minimum": 1 },
        "profile":     { "type": "string" },
        "applied_at":  { "type": "string" }
      }
    },
    "retained": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "committed_at"],
        "additionalProperties": false,
        "properties": {
          "id":             { "type": "integer", "minimum": 1 },
          "committed_at":   { "type": "string" },
          "pinned":         { "type": "boolean" },
          "pinned_reason":  { "type": "string" },
          "is_current":     { "type": "boolean" },
          "bytes_on_disk":  { "type": "integer", "minimum": 0 }
        }
      }
    },
    "drift":      { "type": "array", "items": { "type": "object" } },
    "gc_preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "would_remove": { "type": "array", "items": { "type": "integer" } },
        "would_keep":   { "type": "array", "items": { "type": "integer" } }
      }
    },
    "freshness_grace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "accept_until", "docs", "window_expired"],
        "additionalProperties": false,
        "properties": {
          "source":         { "type": "string" },
          "accept_until":   { "type": "string" },
          "docs":           { "type": "array", "items": { "type": "string" } },
          "window_expired": { "type": "boolean" }
        }
      }
    },
    "revoked_builders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "version", "key_id"],
        "additionalProperties": false,
        "properties": {
          "package": { "type": "string" },
          "version": { "type": "string" },
          "key_id":  { "type": "string" }
        }
      }
    },
    "revocation_freshness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "expires", "state", "acknowledged"],
        "additionalProperties": false,
        "properties": {
          "source":       { "type": "string" },
          "expires":      { "type": "string" },
          "state":        { "type": "string", "enum": ["near_expiry", "expired"] },
          "acknowledged": { "type": "boolean" }
        }
      }
    }
  }
}
