{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polypkg.dev/schemas/resets-v1.json",
  "type": "object",
  "required": ["schema", "scope", "paths"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "polypkg.resets/v1" },
    "scope": { "type": "string", "enum": ["system", "user"] },
    "paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
