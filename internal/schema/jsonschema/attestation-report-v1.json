{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "generated_from", "packages"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "polypkg.attestation-report/v1" },
    "generated_from": {
      "type": "object",
      "required": ["scope", "generations"],
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "generations": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageEvidence" }
    }
  },
  "$defs": {
    "packageEvidence": {
      "type": "object",
      "required": ["name", "version", "generation", "content_hash", "installed_at"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer" },
        "content_hash": { "type": "string", "minLength": 1 },
        "installed_at": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "predicate_types": { "type": "array", "items": { "type": "string" } },
        "attestation_hash": { "type": "string" },
        "policy_at_install": { "type": "string" },
        "gate_disabled": { "type": "boolean" },
        "carried_bindings": { "type": "array", "items": { "$ref": "#/$defs/carriedBinding" } }
      }
    },
    "carriedBinding": {
      "type": "object",
      "required": ["predicate_type", "format", "subject_scope", "tier"],
      "additionalProperties": false,
      "properties": {
        "predicate_type": { "type": "string" },
        "format": { "type": "string" },
        "subject_scope": { "type": "string" },
        "tier": { "type": "string" },
        "verifying_key_id": { "type": "string" },
        "builder_identity": { "type": "string" },
        "certificate_identity": { "type": "string" },
        "certificate_issuer": { "type": "string" }
      }
    }
  }
}
