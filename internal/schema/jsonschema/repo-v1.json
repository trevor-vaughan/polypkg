{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "output", "key"],
  "properties": {
    "schema": { "const": "polypkg.repo/v1" },
    "source": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "output": { "type": "string", "minLength": 1 },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kdf"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kdf": { "enum": ["scrypt", "pbkdf2"] }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          { "required": ["source"] },
          { "required": ["prebuilt"] }
        ],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "prebuilt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "attestations"],
            "properties": {
              "artifact": { "type": "string", "minLength": 1 },
              "attestations": { "type": "string", "minLength": 1 },
              "trust_bundle": { "type": "string", "minLength": 1 },
              "native_attestation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
