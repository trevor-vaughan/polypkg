{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polypkg.dev/schemas/pool-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "serial", "expires", "entries"],
  "properties": {
    "schema": { "const": "polypkg.pool-manifest/v1" },
    "source": { "type": "string", "minLength": 1 },
    "serial": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^blake3:[0-9a-f]+$" },
        "kind": {
          "enum": [
            "index", "index-sig",
            "trust", "trust-sig",
            "trust-bundle", "trust-bundle-sig",
            "revocation-list", "revocation-list-sig",
            "trust-root",
            "artifact", "artifact-sig",
            "attestation", "attestation-sig"
          ]
        }
      }
    }
  }
}
